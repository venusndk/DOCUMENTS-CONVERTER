# Environment configuration reference (Phase 20, master directive
# numbering: Production Release Engineering). Every value here is
# read by documents_converter/api/config.py -- this file only lists
# them with a one-line purpose and a safe example; see config.py's own
# comments for the full reasoning behind each default and constraint.
#
# Nothing here is loaded automatically -- this project reads real
# process environment variables (os.environ), not a .env file, so
# there's no python-dotenv dependency to add. Copy what you need into
# your real deployment's own environment (a docker-compose .env file
# works too, since Compose does read and substitute from one
# automatically for ${VAR} references in docker-compose.yml).
#
# A fresh checkout needs NONE of these set -- every default below is
# this project's own local/dev behavior with zero configuration.

# --- Core conversion behavior -----------------------------------------------

# Only needed if tesseract/soffice aren't already on PATH.
# TESSERACT_CMD=/usr/bin/tesseract
# LIBREOFFICE_CMD=/usr/bin/soffice

# Reject an upload larger than this before reading its body.
MAX_UPLOAD_MB=50

# Wall-clock cap on one synchronous /api/v1/convert call, and the
# job_timeout every async /api/v1/jobs conversion runs under.
CONVERT_TIMEOUT_SECONDS=180

# --- Access control (Phase 6) -----------------------------------------------

# Comma-separated pre-shared keys. Empty (the default) means every
# /api/v1/* route is unauthenticated -- fine for local/trusted-network
# use, required before exposing this beyond that (ENVIRONMENT=production
# refuses to start with this unset -- see below).
# API_KEYS=change-me-to-a-real-random-key,another-key-for-a-second-caller

RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# --- Environment / startup guard (Phase 11) ---------------------------------

# "development" (default) or "production". In production, this process
# refuses to start at all with API_KEYS unset -- see
# app._check_startup_config. Also affects cookie Secure flags (Phase 17).
ENVIRONMENT=development

# --- Database (Phase 1 completion) ------------------------------------------

# Defaults to a local SQLite file -- point this at Postgres for a real,
# multi-replica-safe deployment (required once more than one api/worker
# process needs to see the same job/account/audit data).
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/documents_converter

# --- Job queue (Phase 14) ---------------------------------------------------

REDIS_URL=redis://localhost:6379/0
JOB_MAX_RETRIES=2
JOB_RETENTION_SECONDS=3600

# Shared scratch-file location -- REQUIRED once the api and worker run
# as separate containers/processes (docker-compose.yml sets this to a
# shared volume automatically; only needed by hand for a deployment
# that doesn't use that compose file).
# WORK_DIR_ROOT=/app/work

# Durable copy of the audit trail, in addition to stdout and the
# database (Phase 18) -- optional; a mounted volume path.
# AUDIT_LOG_PATH=/app/data/audit.log

# --- AI Document Intelligence (Phase 16) ------------------------------------

# Unset (default) disables every /api/v1/ai/* endpoint (503) -- entirely
# optional. See ai_intelligence.py's own docstring for why Gemini, and
# the real free-tier daily-quota ceiling that comes with it.
# GEMINI_API_KEY=your-real-key-here
AI_MODEL=gemini-3.6-flash
AI_MAX_TEXT_CHARS=20000

# --- Authentication & User Workspace (Phase 17) -----------------------------

# Signs the CSRF cookie -- an ephemeral one is generated per-process if
# unset (fine for local/dev; every already-logged-in browser's CSRF
# token stops validating on the next restart). Set a real, stable value
# before relying on sessions surviving a restart/redeploy.
# SESSION_SECRET=a-long-random-string-generated-once-and-kept-stable
SESSION_MAX_AGE_SECONDS=1209600

# --- Administration & Observability (Phase 18) ------------------------------

# Comma-separated emails -- promoted to real admin accounts
# (User.is_admin) the next time they sign up or log in. Empty (default)
# means no admin exists and every /api/v1/admin/* route stays a 403.
# ADMIN_EMAILS=you@example.com
